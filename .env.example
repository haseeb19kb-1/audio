# =============================================================================
# ZEVO LIVE — Environment Variable Configuration Template
# WARNING: Never commit real production secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsIn..."
# Strictly server-side only: Used in Edge Functions & Admin API
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsIn..."

# Mobile App Public Exposure (Prefix with EXPO_PUBLIC_ for client bundling)
EXPO_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsIn..."

# -----------------------------------------------------------------------------
# LiveKit Cloud (Real-time WebRTC Audio SFU)
# -----------------------------------------------------------------------------
LIVEKIT_URL="wss://zevo-live.livekit.cloud"
EXPO_PUBLIC_LIVEKIT_URL="wss://zevo-live.livekit.cloud"
# Strictly server-side only: Used in Edge Functions to sign room JWTs
LIVEKIT_API_KEY="APIxxxxxxxxxxx"
LIVEKIT_API_SECRET="sec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# -----------------------------------------------------------------------------
# Upstash Redis (Edge Rate Limiting & Transient Cache)
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL="https://your-cluster.upstash.io"
UPSTASH_REDIS_REST_TOKEN="Axxxxxxxxxxxxxxxxxxxxxxx="

# -----------------------------------------------------------------------------
# Mobile In-App Purchases (Digital Coins Billing)
# -----------------------------------------------------------------------------
# Apple App Store Server Notifications V2
APPLE_IAP_BUNDLE_ID="com.zevolive.app"
APPLE_IAP_KEY_ID="8X9XXXXXXX"
APPLE_IAP_ISSUER_ID="57246542-96fe-1a63-e053-0824d011072a"
APPLE_IAP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Google Play Real-Time Developer Notifications (RTDN)
GOOGLE_PLAY_PACKAGE_NAME="com.zevolive.app"
GOOGLE_APPLICATION_CREDENTIALS_JSON="{}"

# -----------------------------------------------------------------------------
# Push Notifications & Error Monitoring
# -----------------------------------------------------------------------------
EXPO_PROJECT_ID="your-expo-project-uuid"
SENTRY_DSN="https://xxxxxx@sentry.io/1234567"
